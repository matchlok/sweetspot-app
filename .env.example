# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# intervals.icu: Settings > Developer Settings > API Key. Athlete ID looks like i12345.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Claude API (Phase 2+)
ANTHROPIC_API_KEY=

# Google Calendar service account, full JSON on one line, wrapped in single quotes (Phase 1+)
# All other values are unquoted.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Postgres connection string (Phase 1+)
DATABASE_URL=

# Auth (run: node scripts/setup-auth.mjs, which fills these without printing them)
JWT_SECRET=
APP_PASSPHRASE_HASH=
CRON_SECRET=
