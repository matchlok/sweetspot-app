INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Claude API (Phase 2+)
ANTHROPIC_API_KEY=

# Google Calendar service account, full JSON on one line (Phase 1+)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Postgres connection string (Phase 1+)
DATABASE_URL=
